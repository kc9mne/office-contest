# Copy to .env and fill in. deploy/setup-ubuntu.sh creates .env for you on Ubuntu.
# Never commit .env: it holds your database password and AI key.

# Full address people use to reach the site (used for share links and QR codes)
APP_URL=https://officevote.example.com

DB_DSN=mysql:host=localhost;dbname=officevote;charset=utf8mb4
DB_USER=officevote
DB_PASS=change-me

# Photobooth AI (OpenAI image editing). The easiest way to add the key is
# Admin > Site settings > Photobooth AI, which stores it encrypted.
# A key set here takes priority and can't be changed from Admin.
# With no key anywhere, the booth runs in demo mode (a color filter, no AI).
OPENAI_API_KEY=
# Model and quality defaults; Admin > Site settings overrides them
OPENAI_IMAGE_MODEL=gpt-image-1
# low | medium | high (higher costs more per photo)
OPENAI_IMAGE_QUALITY=medium
# high keeps faces closer to the original; set to off for models that don't support it
OPENAI_INPUT_FIDELITY=high

# Show PHP errors in the browser (development only)
APP_DEBUG=0
